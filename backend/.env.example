# Server Configuration
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ojaplus

# JWT Authentication (REQUIRED)
# Generate strong secrets: openssl rand -base64 32
JWT_SECRET=your-secret-key-at-least-32-characters-long-change-this
JWT_REFRESH_SECRET=your-refresh-secret-key-at-least-32-characters-long-change-this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Configuration (REQUIRED)
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# Trusted IPs (Optional - for rate limit bypass)
# Comma-separated list of IP addresses
TRUSTED_IPS=

# Cloudflare R2 / S3 Media Storage (REQUIRED)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_MEDIA_BUCKET=rhythm-root
R2_MEDIA_PUBLIC_HOST=https://media.rhythmplusroot.com

# SendGrid Email (Optional - for password reset)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# Stripe Payment Processing (Optional - for reservations)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Analytics (Optional)
VITE_GA_MEASUREMENT_ID=

# Logging
LOG_LEVEL=info

# Legacy (for seed script)
SEED_DATA_DIR=data
ROOT_ADMIN_EMAIL=admin@rhythmplusroot.com
ROOT_ADMIN_PASSWORD=admin
